{
  "name": "fintech-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:wasm && ng serve",
    "build": "npm run build:wasm && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run build:wasm && ng test --watch=false",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:pages": "npm run build:wasm && ng build --base-href /fintech-dashboard/",
    "lint": "eslint ."
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@angular/material": "^21.2.0",
    "@angular/cdk": "^21.2.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "27.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.11",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.0.0",
    "angular-eslint": "^21.0.0"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "overrides": {
    "vitest": "4.1.11",
    "@vitest/browser-playwright": "4.1.11"
  }
}
